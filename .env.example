API_PREFIX=/v1
VENDOR_TIMEOUT_SECONDS=8
ENABLE_DEMO_VENDOR=true
VENDOR_MAX_CONCURRENCY=20
DHILLU_SAHI_BASE_URL=https://api.dhilluandsahi.com
DHILLU_SAHI_EMAIL=
DHILLU_SAHI_PASSWORD=
DHILLU_SAHI_TIMEOUT_SECONDS=10
# Sector group ids for the listing (my_sector_id), comma-separated; one call each, merged. Required: there is no
# default, and without it Dhillu & Sahi is not configured. Example only: DHILLU_SAHI_SECTOR_GROUP_IDS=9,29,26
DHILLU_SAHI_SECTOR_GROUP_IDS=
# Optional: without them the login's token and agent_id are used.
DHILLU_SAHI_TOKEN=
DHILLU_SAHI_AGENT_ID=
# Off switch for Dhillu & Sahi Hold seats (add-booking).
GROUP_DHILLU_SAHI_HOLD_ENABLED=true
# Dhillu & Sahi hold time in minutes (their booking detail gives no expiry): hold time + this.
DHILLU_SAHI_HOLD_DEFAULT_MINUTES=45
# Al Haider group inventory: permanent access token (Bearer), no login.
AL_HAIDER_BASE_URL=
AL_HAIDER_ACCESS_TOKEN=
# Al Haider Hold seats (create/booking). Off until Al Haider confirms an unpaid booking expires by itself.
GROUP_AL_HAIDER_HOLD_ENABLED=false
# agency_info for Al Haider bookings is read from the account profile (GET /api/user) at hold time.
SKYPASS_ENDPOINT=
SKYPASS_CLIENT_ID=
SKYPASS_CLIENT_SECRET=
# RateHawk (hotels): B2B API v3 + Content API v1, HTTP Basic (key id + API key). Sandbox:
# https://api-sandbox.ratehawk.com. Without all three, hotel search answers "not configured".
RATEHAWK_ENDPOINT=
RATEHAWK_KEY_ID=
RATEHAWK_API_KEY=
RATEHAWK_TIMEOUT_SECONDS=30
# Search defaults. The sandbox rejects PKR, so USD.
RATEHAWK_CURRENCY=USD
RATEHAWK_RESIDENCY=pk
RATEHAWK_LANGUAGE=en
# Supplier-state calls in the Super Admin RateHawk console (booking, cancel, order groups, profiles). Off by default.
RATEHAWK_WRITE_ENABLED=false
# Hotel selling price = supplier price + this percent. Empty = 0 (sells at the supplier price).
HOTEL_MARKUP_PERCENT=
LOG_LEVEL=INFO
AWS_REGION=
SSM_PARAMETER_PREFIX=

# Optional identity verification; keep blank until approved for the deployment.
# This is independent of AWS_REGION used for supplier SSM settings.
COGNITO_ISSUER=
COGNITO_APP_CLIENT_ID=

# Booking role policy: disabled until agency-claim governance is approved.
# The custom claim must be emitted in verified ACCESS tokens by trusted config.
COGNITO_AGENCY_CLAIM=
BOOKING_CREATE_GROUPS=[]
BOOKING_DETAILS_GROUPS=[]

# Local agency database. No startup connection or automatic migrations.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=travelian
DB_USER=travelian_local
# Optional for migrations: leave blank to enter a hidden password prompt.
DB_PASSWORD=

# Legacy group-policy settings: no longer used for human admin authorization.
# Local users/roles now control access; see docs/api/users-and-roles.md.
AGENCY_ADMIN_READ_GROUPS=[]
AGENCY_ADMIN_WRITE_GROUPS=[]
AGENCY_ADMIN_REVIEW_GROUPS=[]

# Full Cognito custom scope names; disabled until resource server is approved.
INTEGRATION_SEARCH_SCOPE=
INTEGRATION_BOOKING_CREATE_SCOPE=
INTEGRATION_BOOKING_DETAILS_SCOPE=

# Admin Dashboard (data: gateway `bookings` table, migration 0008; uses the DB_* settings above).
# Expiring-holds window for the Dashboard card, in hours (1-168).
DASHBOARD_EXPIRING_HOLD_HOURS=2
DASHBOARD_TIMEZONE=Asia/Karachi

# Exact portal origins allowed by CORS (JSON list, no wildcard, no trailing slash).
# Example: ["http://localhost:8080","https://admin.example.com"]
CORS_ALLOWED_ORIGINS=[]

# Group Ticketing selling price (D23): supplier price + percent + fixed amount in paisa.
# With both 0, no selling price is returned to anyone.
GROUP_TICKETING_MARKUP_PERCENT=
GROUP_TICKETING_MARKUP_FIXED_MINOR=
# Travelian's own group hold time in minutes (suppliers hold longer). The expiry job releases the seats.
GROUP_HOLD_MINUTES=30
GROUP_HOLD_JOB_INTERVAL_SECONDS=30
GROUP_HOLD_RELEASE_ATTEMPTS=5
GROUP_TICKETING_DEFAULT_CURRENCY=PKR

# Southair flights (AEROST OTA API). Fill these in .env only; never commit values.
SOUTHAIR_BASE_URL=
SOUTHAIR_USERNAME=
SOUTHAIR_PASSWORD=
SOUTHAIR_TIMEOUT_SECONDS=20
# Hold-only booking and ticketing switches. Both stay false unless you are running a supervised UAT test.
SOUTHAIR_BOOKING_ENABLED=false
SOUTHAIR_TICKETING_ENABLED=false
# Flight selling price (D23): supplier fare + percent + fixed paisa per passenger. With both 0, no price is returned.
FLIGHT_MARKUP_PERCENT=
FLIGHT_MARKUP_FIXED_MINOR=
# SooperFare platform fee per booking (minor units) for search prices; the real fee comes with the quote. Default 2000 (Rs 20).
# SOOPERFARE_PLATFORM_FEE_MINOR=2000
# Optional cap on a revalidated price increase, in paisa. Empty: no cap (acceptance only).
FLIGHT_PRICE_CHANGE_LIMIT_MINOR=

# Public website booking (guests, no login). false: bookings are saved as requests for staff (no supplier call,
# no payment). true: seats are held at the supplier and the guest can pay online.
PUBLIC_GROUP_BOOKING_ENABLED=false
# Website flights. false: saved as requests for staff. true: held at the supplier (needs SOUTHAIR_/SOOPERFARE_BOOKING_ENABLED);
# card (PayFast) is issued automatically after PayFast's verified payment when that provider's ticketing is on (D48);
# bank transfer and JazzCash stay held until staff verify the money and issue (D49).
PUBLIC_FLIGHT_BOOKING_ENABLED=false
# Show Umrah on the website (D39). Off (default): hidden everywhere, nothing deleted.
UMRAH_ENABLED=false
PUBLIC_SITE_URL=https://travelian.pk
PUBLIC_API_URL=https://api.travelian.pk
PUBLIC_SEARCH_CACHE_SECONDS=120
# PayFast (Pakistan) hosted checkout. Sandbox host https://ipguat.apps.net.pk. Never commit real values.
# true only while testing on UAT credentials: card / 1Link offered and auto-issuing on with PayFast UAT.
PAYFAST_ALLOW_UAT=false
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_MERCHANT_NAME=Travelian
PAYFAST_BASE_URL=https://ipguat.apps.net.pk

# SooperFare (airline aggregator). Calls go out from the static IP SooperFare whitelists (52.76.26.224).
SOOPERFARE_BASE_URL=https://api.sooperfare.com
SOOPERFARE_USERNAME=
SOOPERFARE_PASSWORD=
SOOPERFARE_BOOKING_ENABLED=false
SOOPERFARE_TICKETING_ENABLED=false

# Staff notifications (holds, booking requests): recorded always; emailed through Amazon SES when enabled.
NOTIFY_EMAIL_ENABLED=false
NOTIFY_EMAILS=
NOTIFY_EMAIL_FROM=Travelian <noreply@travelian.pk>
SES_REGION=us-east-1
# Restricted airlines (D32): IATA codes; Parameter Store <SSM_PARAMETER_PREFIX>/flights/restricted-airlines wins when set.
RESTRICTED_AIRLINES=EY,QR
# Checkout payment methods. JazzCash is a scaffold (D31): keep false until merchant credentials are confirmed.
BANK_TRANSFER_ENABLED=false
JAZZCASH_ENABLED=false
# Admin-uploaded media in S3 (D38).
ASSETS_BUCKET=
ASSETS_REGION=ap-southeast-1
ASSETS_PUBLIC_BASE_URL=
