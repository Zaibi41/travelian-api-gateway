# Travelian public entry point on the Lightsail instance (static IP 52.76.26.224).
#
#   https://api.travelian.pk/v1/*   -> travelian-api-gateway (127.0.0.1:8000)
#   https://api.travelian.pk/*      -> legacy API Gateway + Lambda (/content/*, /flights/*,
#                                      /hotels/search, /health) until it is retired
#   Retired (B14, 19 Nov 2026): the Lambda's PayFast routes (/payments/payfast/*: its callback marked bookings
#   paid without verification) and its group-ticketing feed (/group-ticketing/*: it exposed supplier codes).
#   Payments and group fares go through the gateway (/v1/public/...). Answer 410 Gone; nothing reaches the Lambda.
#   Retired (gateway#82, 21-22 Nov 2026): the Lambda's /content/bookings*, /content/booking-requests* and /content/customers (read and
#   write with no sign-in; they returned traveler contact details and supplier cost). No screen uses them; bookings
#   are in the gateway (/v1/admin/bookings, /v1/public/...). One prefix covers both routes, their /{id} paths,
#   trailing slashes and encoded variants (Caddy matches the unescaped path, case-insensitively, slashes merged).
#   No indexing (gateway#81): /robots.txt (disallow all) is answered by the gateway, and every response, the
#   legacy Lambda's too, carries X-Robots-Tag: noindex (the gateway sets it on its own; Caddy adds it when missing).
#
# LEGACY_API_TARGET is the "API Gateway domain name" of the api.travelian.pk custom
# domain (d-xxxxxxxxxx.execute-api.us-east-1.amazonaws.com). It is set in
# /etc/systemd/system/caddy.service.d/travelian.conf by deploy/server-setup.sh.
# The legacy API is reached with Host and TLS name api.travelian.pk, so its custom
# domain and base-path mappings keep working after DNS moves here.
#
# Certificates come from Let's Encrypt automatically once DNS points at this server
# and ports 80 and 443 are open in the Lightsail firewall.

{
	email {$ACME_EMAIL}
}

(travelian_routes) {
	encode gzip
	header ?X-Robots-Tag noindex

	handle /v1/* {
		reverse_proxy {$GATEWAY_UPSTREAM:127.0.0.1:8000}
	}

	handle /robots.txt {
		reverse_proxy {$GATEWAY_UPSTREAM:127.0.0.1:8000}
	}

	@retired path /payments/payfast/* /group-ticketing /group-ticketing/*
	handle @retired {
		header Content-Type application/json
		respond `{"error":"GONE","message":"This endpoint was retired. Use https://api.travelian.pk/v1/public."}` 410
	}

	@retired_content path /content/booking* /content/customers /content/customers/*
	handle @retired_content {
		header Content-Type application/json
		respond `{"error":"GONE","message":"This endpoint was retired."}` 410
	}

	handle {
		reverse_proxy https://{$LEGACY_API_TARGET} {
			header_up Host api.travelian.pk
			transport http {
				tls_server_name api.travelian.pk
			}
		}
	}
}

api.travelian.pk {
	import travelian_routes
}

# Test name used before moving api.travelian.pk; remove after cutover.
gw-test.travelian.pk {
	import travelian_routes
}
