          "raw": "{{END_POINT}}/operations",
          "host": [
            "{{END_POINT}}"
          ],
          "path": [
            "operations"
          ]
        },
        "description": "Every SooperFare call the gateway can send, with its gateway path and whether it changes a booking."
      },
      "response": []
