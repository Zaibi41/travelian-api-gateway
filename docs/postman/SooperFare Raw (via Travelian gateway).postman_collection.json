{
  "info": {
    "name": "SooperFare Raw (via Travelian gateway)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Every SooperFare partner call, sent unchanged through the Travelian gateway (SooperFare only accepts the gateway's IP). Answers are SooperFare's own body; header X-Supplier-Status carries SooperFare's HTTP status.\n\nSet TRAVELIAN_TOKEN to a Super Admin Cognito ACCESS token (Bearer). The gateway logs in to SooperFare itself; there is no Login request.\n\nRequests marked [changes booking] need SOOPERFARE_RAW_WRITE_ENABLED=true on the gateway. Confirm issues tickets and charges the SooperFare balance.\n\nBuilt from SooperFare's 'SooperFare Shareable' collection, with SooperFare auth headers and the login request removed."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{TRAVELIAN_TOKEN}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "GATEWAY",
      "value": "https://api.travelian.pk"
    },
    {
      "key": "END_POINT",
      "value": "{{GATEWAY}}/v1/admin/suppliers/sooperfare/raw"
    },
    {
      "key": "TRAVELIAN_TOKEN",
      "value": ""
    }
  ],
  "item": [
